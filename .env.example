# Neon Postgres — app tables (sessions/notes) AND LangGraph checkpointer
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: direct (non-pooler) URL if checkpointer.setup() fails on the pooler
# CHECKPOINT_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — same Auth Base URL as the frontend, no /auth suffix extra
# Console → Auth → Configuration → Auth Base URL
NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# CORS for the Vite dev server
CORS_ORIGINS=http://localhost:5173

# Existing RAG keys
OPENAI_API_KEY=
GROQ_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis Cloud — embedding cache only (CacheBackedEmbeddings byte store). Not Qdrant.
# Use the Redis Cloud public endpoint, typically rediss://default:<password>@<host>:<port>
REDIS_URL=
# Eviction is Redis Cloud dashboard only (maxmemory + allkeys-lru). CONFIG SET is blocked.
TAVILY_API_KEY=

# Chat retrieval: hybrid (default) or dense
RETRIEVAL_STRATEGY=hybrid
RRF_DENSE_WEIGHT=0.9
RRF_BM25_WEIGHT=0.1
# Cross-encoder after RRF (set false to skip). First retrieve may download weights.
USE_CROSS_ENCODER=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
